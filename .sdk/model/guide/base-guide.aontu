# Guide

guide: {
  metrics: count: entity: 9
  metrics: count: path: 9
  metrics: count: method: 9

  entity: health: {
    path: "/healthz": {
      op: load: method: *GET
      op: load: transform: res: *("`body.render`")|top
    }
  }

  entity: monitoring_request: {
    path: "/api/monitoring-requests": {
      op: create: method: *POST
      op: create: transform: res: *("`body.request`")|top
    }
  }

  entity: pilot_request: {
    path: "/api/pilot-requests": {
      op: create: method: *POST
      op: create: transform: res: *("`body.request`")|top
    }
  }

  entity: render: {
    path: "/v1/render": {
      op: create: method: *POST
    }
  }

  entity: rendering: {
    path: "/v1/screenshot": {
      op: load: method: *GET
    }
  }

  entity: safety_review_request: {
    path: "/api/safety-review-requests": {
      op: create: method: *POST
      op: create: transform: res: *("`body.request`")|top
    }
  }

  entity: trial: {
    path: "/api/trials": {
      op: create: method: *POST
      op: create: transform: res: *("`body.trial`")|top
    }
  }

  entity: upgrade: {
    path: "/v1/upgrade-requests": {
      op: create: method: *POST
      op: create: transform: res: *("`body.request`")|top
    }
  }

  entity: usage: {
    path: "/v1/usage": {
      op: load: method: *GET
      op: load: transform: res: *("`body.usage`")|top
    }
  }

}