# Entity: health

main: kit: entity: health: {

  alias: field: {}

  fields: [
    {
      name: "active"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "concurrency"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "pending"
      req: true
      type: "`$INTEGER`"
    }
  ]

  name: "health"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/healthz"
          segments: [
            {
              lit: "healthz"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.render`"
          }
        }
      ]
    }
  }



}
