# Entity: trial

main: kit: entity: trial: {

  alias: field: {}

  fields: [
    {
      name: "consent"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "email"
      req: true
      type: "`$STRING`"
    }
    {
      name: "expectedRenders"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "useCase"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "trial"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/trials"
          parts: [
            "api"
            "trials"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.trial`"
          }
        }
      ]
    }
  }



}
